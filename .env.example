# MBTI 人格辩论平台 — 环境变量
# 复制为 .env 并修改值

# 后端服务端口
PORT=3001

# JWT 密钥（生产环境务必修改为随机字符串）
JWT_SECRET=mbti-debate-platform-secret-2026

# 前端容器暴露端口
FRONTEND_PORT=80

# 数据库路径（Docker 中固定为 /app/data/debate.db）
DB_PATH=/app/data/debate.db

# 环境模式
NODE_ENV=production

# =====================================================
# v40+ 知乎 API 配置（用于：全网搜索 / 直答 LLM / 热榜）
# =====================================================
# 申请地址：https://developer.zhihu.com/
# 填入后三大能力激活：
#   - 直答 API → 替换 llmClient 的 backend，平台真正有"在线大脑"
#   - 全网搜索 → 辩论大师的 research 资料包从骨架升级为真实数据
#   - 热榜 API  → NewsLibrary 加新 tab，比 RSS 更新鲜
ZHIHU_ACCESS_SECRET=
# 直答 LLM 模型可选：
#   zhida-fast-1p5       ：快速档（≤2 秒，低延迟，适合赛中 tip）
#   zhida-thinking-1p5   ：深度思考档（质量高，适合赛后复盘）
#   zhida-agent          ：智能思考档（带工具调用，适合资料研究）
ZHIHU_MODEL_FAST=zhida-fast-1p5
ZHIHU_MODEL_THINKING=zhida-thinking-1p5
ZHIHU_MODEL_AGENT=zhida-agent
# 直答 API 速率限制（每分钟请求数），无 secret 时走本地 fallback
ZHIHU_RATE_LIMIT_RPM=60

# v40.6 知乎账号绑定 - 用于 AES-256-GCM 加密用户提交的 z_c0 cookie
# 至少 32 字符；首次部署可用以下命令生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,48))"
ZHIHU_COOKIE_KEY=replace-me-with-a-random-32-char-or-longer-secret-key

